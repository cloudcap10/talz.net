---
import Layout from '@/layouts/Layout.astro';

const SECTIONS = [
  { id: 'what-is-ospf', title: 'What is OSPF?' },
  { id: 'how-ospf-works', title: 'How OSPF Works' },
  { id: 'characteristics', title: 'Characteristics' },
  { id: 'network-types', title: 'Network Types' },
  { id: 'areas', title: 'Areas & Hierarchy' },
  { id: 'neighbor-states', title: 'Neighbor States' },
  { id: 'timers', title: 'Timers' },
  { id: 'packet-types', title: 'Packet Types' },
  { id: 'lsa-types', title: 'LSA Types' },
  { id: 'route-types', title: 'Route Types' },
  { id: 'cost', title: 'Cost Calculation' },
  { id: 'dr-bdr', title: 'DR & BDR' },
  { id: 'authentication', title: 'Authentication' },
  { id: 'configuration', title: 'Configuration' },
  { id: 'commands', title: 'Commands' },
  { id: 'interview-questions', title: 'Interview Questions' },
  { id: 'advanced', title: 'Advanced Concepts' },
];
---

<Layout title="OSPF Cheatsheet — Joven Talasan" description="Comprehensive OSPF study guide covering areas, LSA types, DR/BDR, cost calculation, configuration, and interview questions.">
  <main>
    <div class="max-w-4xl mx-auto px-6 py-12">
      <a href="/cheatsheet" class="inline-flex items-center gap-1.5 text-sm mb-8" style="color: var(--accent)">
        ← back to cheatsheets
      </a>

      <h1 class="font-black uppercase tracking-tight mb-2" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95">
        OSPF<br>
        <span style="color: var(--accent)">Cheatsheet</span>
      </h1>
      <p class="text-sm mb-10 max-w-xl" style="color: var(--text-muted); line-height: 1.7">
        Open Shortest Path First — Link-State IGP using Dijkstra's SPF algorithm. Open standard, IP protocol 89.
      </p>

      <div class="flex flex-wrap gap-2 mb-12">
        {SECTIONS.map(s => (
          <a href={"#" + s.id} class="text-xs px-3 py-1 rounded-full font-mono transition-colors" style="background: var(--bg-surface); color: var(--text-muted)">
            {s.title}
          </a>
        ))}
      </div>

      <div class="flex flex-col gap-10">

        <section id="what-is-ospf">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">1. What is OSPF?</h2>
          <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
            <p class="text-sm leading-relaxed" style="color: var(--text-muted)">
              OSPF is an Interior Gateway Protocol (IGP) used in IP networks. It is a <strong style="color: var(--text)">Link-State</strong>
              routing protocol that uses <strong style="color: var(--text)">Dijkstra's SPF algorithm</strong> to find the shortest path.
              It is <strong style="color: var(--text)">open standard</strong> and uses <strong style="color: var(--text)">protocol number 89</strong>.
            </p>
          </div>
        </section>

        <section id="how-ospf-works">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">2. How OSPF Works</h2>
          <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
            <ul class="text-sm leading-relaxed space-y-1.5" style="color: var(--text-muted)">
              <li>• Routers discover neighbors using <strong style="color: var(--text)">Hello</strong> packets.</li>
              <li>• They build a <strong style="color: var(--text)">Link-State Database (LSDB)</strong> of the area.</li>
              <li>• LSDB is synchronized with all routers in the area.</li>
              <li>• <strong style="color: var(--text)">SPF algorithm</strong> calculates the best path.</li>
              <li>• Best paths are installed in the routing table.</li>
              <li>• Updates are triggered on topology change only.</li>
            </ul>
          </div>
        </section>

        <section id="characteristics">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">3. OSPF Characteristics</h2>
          <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
            <ul class="text-sm leading-relaxed space-y-1.5" style="color: var(--text-muted)">
              <li>• Link-State Protocol</li>
              <li>• Hierarchical Design (Area Based)</li>
              <li>• Classless (CIDR / VLSM Support)</li>
              <li>• Supports Authentication</li>
              <li>• Fast Convergence</li>
              <li>• Scalable and Efficient</li>
              <li>• Uses IP Protocol 89</li>
              <li>• Equal-Cost Load Balancing (ECMP)</li>
            </ul>
          </div>
        </section>

        <section id="areas">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">4. OSPF Areas & Hierarchy</h2>
          <div class="p-4 rounded-xl border-2 mb-4" style="background: var(--bg-card); border-color: var(--border)">
            <p class="text-sm" style="color: var(--text-muted)"><strong style="color: var(--text)">Backbone Area</strong> = Area 0 (Mandatory). All other areas connect to Area 0.</p>
          </div>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Area Type</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Standard</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Normal OSPF area</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Stub</td><td class="px-4 py-2.5" style="color: var(--text-muted)">No external routes (Type-5 blocked)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Totally Stubby</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Only default route (Type-3/4/5 blocked)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">NSSA</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Allows external routes via Type-7 LSA</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Totally NSSA</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Only default route via NSSA</td></tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs mt-2" style="color: var(--text-faint)">Smaller areas = Better performance.</p>
        </section>

        <section id="neighbor-states">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">5. OSPF Neighbor States</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">State</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Down</td><td class="px-4 py-2.5" style="color: var(--text-muted)">No Hello received</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Init</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Hello sent</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">2-Way</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Bi-directional Hello received</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">ExStart</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Master/Slave decided</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Exchange</td><td class="px-4 py-2.5" style="color: var(--text-muted)">DBDs are exchanged</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Loading</td><td class="px-4 py-2.5" style="color: var(--text-muted)">LSAs are requested</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Full</td><td class="px-4 py-2.5" style="color: var(--text-muted)">LSDBs are synchronized</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="timers">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">6. OSPF Timers (Default)</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Timer</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Default</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Hello Interval</td><td class="px-4 py-2.5">10 sec (Broadcast)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Dead Interval</td><td class="px-4 py-2.5">40 sec (4× Hello)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">LSA Refresh Time</td><td class="px-4 py-2.5">30 min</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">LSA Max Age</td><td class="px-4 py-2.5">60 min</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">SPF Calculation Delay</td><td class="px-4 py-2.5">5 sec</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">SPF Hold Time</td><td class="px-4 py-2.5">10 sec</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">LSA Throttle Interval</td><td class="px-4 py-2.5">5 sec</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="packet-types">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">7. OSPF Packet Types</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Packet</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Purpose</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Hello</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Discover & maintain neighbors</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">DBD</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Database Description — exchange LSDB summary</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">LSR</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Link State Request — request specific LSAs</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">LSU</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Link State Update — send LSAs</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">LSAck</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Link State Acknowledgment — acknowledge LSAs</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="lsa-types">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">8. OSPF LSA Types</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Type</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Name</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">1</td><td class="px-4 py-2.5">Router LSA</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Router's links within an area</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">2</td><td class="px-4 py-2.5">Network LSA</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Generated by DR on multi-access</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">3</td><td class="px-4 py-2.5">Summary LSA</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Inter-area routes (ABR generated)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">4</td><td class="px-4 py-2.5">ASBR Summary LSA</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Path to ASBR</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">5</td><td class="px-4 py-2.5">AS External LSA</td><td class="px-4 py-2.5" style="color: var(--text-muted)">External routes (ASBR generated)</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">7</td><td class="px-4 py-2.5">NSSA External LSA</td><td class="px-4 py-2.5" style="color: var(--text-muted)">External routes in NSSA</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="route-types">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">9. OSPF Route Types</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Type</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Code</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Intra-Area</td><td class="px-4 py-2.5">O</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Within the same area</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Inter-Area</td><td class="px-4 py-2.5">O IA</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Between different areas</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">External Type-1</td><td class="px-4 py-2.5">E1</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Cost includes internal + external</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">External Type-2</td><td class="px-4 py-2.5">E2</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Cost includes external only (default)</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">NSSA External</td><td class="px-4 py-2.5">N1/N2</td><td class="px-4 py-2.5" style="color: var(--text-muted)">External in NSSA</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="cost">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">10. OSPF Cost Calculation</h2>
          <div class="p-4 rounded-xl border-2 mb-4" style="background: var(--bg-card); border-color: var(--border)">
            <code class="text-sm" style="color: var(--text-muted)">Cost = Reference Bandwidth / Interface Bandwidth</code>
          </div>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Property</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Value</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Default Reference BW</td><td class="px-4 py-2.5">100 Mbps</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Command to change</td><td class="px-4 py-2.5"><code>auto-cost reference-bandwidth</code></td></tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs mt-2" style="color: var(--text-faint)">Lower cost = Preferred path.</p>
        </section>

        <section id="dr-bdr">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">11. DR & BDR</h2>
          <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
            <ul class="text-sm leading-relaxed space-y-1.5" style="color: var(--text-muted)">
              <li>• On <strong style="color: var(--text)">multi-access</strong> networks, OSPF elects DR and BDR.</li>
              <li>• <strong style="color: var(--text)">DR</strong> handles all LSAs and forms adjacencies with other routers.</li>
              <li>• <strong style="color: var(--text)">BDR</strong> is the standby router.</li>
              <li>• Reduces LSA flooding and improves efficiency.</li>
              <li>• <strong style="color: var(--text)">Point-to-Point</strong> links do not have DR/BDR.</li>
            </ul>
          </div>
        </section>

        <section id="authentication">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">12. OSPF Authentication</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Type</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Type 0</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Null Authentication (No Password)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Type 1</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Simple Password (Plaintext)</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Type 2</td><td class="px-4 py-2.5" style="color: var(--text-muted)">MD5 Authentication (More Secure)</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="configuration">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">13. OSPF Configuration</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
              <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--accent)">Single Area (0)</p>
              <pre class="font-mono text-xs leading-relaxed" style="color: var(--text-muted)">router ospf 1
 router-id 1.1.1.1
 network 192.168.1.0 0.0.0.255 area 0
 network 192.168.2.0 0.0.0.255 area 0
 passive-interface default
 no passive-interface g0/0</pre>
            </div>
            <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
              <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--accent)">Multi-Area (0 + 1)</p>
              <pre class="font-mono text-xs leading-relaxed" style="color: var(--text-muted)">router ospf 1
 router-id 1.1.1.1
 network 30.0.0.0 0.0.0.255 area 0
 network 10.0.1.0 0.0.0.255 area 1</pre>
            </div>
          </div>
        </section>

        <section id="commands">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">14. Important OSPF Commands</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Command</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Purpose</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">show ip ospf neighbor</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Show neighbors</td></tr>
