---
import Layout from '@/layouts/Layout.astro';

const CATEGORIES = [
  {
    name: 'Navigation & Basics',
    cmds: [
      { n: 'ls', d: 'List directory contents' },
      { n: 'll', d: 'Long listing (with permissions)' },
      { n: 'cd', d: 'Change directory' },
      { n: 'pwd', d: 'Print working directory' },
    ],
  },
  {
    name: 'File Operations',
    cmds: [
      { n: 'mkdir', d: 'Make directory' },
      { n: 'rmdir', d: 'Remove empty directory' },
      { n: 'rm', d: 'Remove files or directories' },
      { n: 'cp', d: 'Copy files or directories' },
      { n: 'mv', d: 'Move or rename files/directories' },
      { n: 'touch', d: 'Create an empty file / update timestamp' },
    ],
  },
  {
    name: 'File Viewing & Editing',
    cmds: [
      { n: 'cat', d: 'Display file contents' },
      { n: 'less', d: 'View file contents interactively' },
      { n: 'head', d: 'Show first 10 lines of a file' },
      { n: 'tail', d: 'Show last 10 lines of a file' },
      { n: 'nano', d: 'Text editor (nano)' },
      { n: 'vi / vim', d: 'Text editor (vi/vim)' },
    ],
  },
  {
    name: 'Text Processing & Searching',
    cmds: [
      { n: 'grep', d: 'Search text in files' },
      { n: 'echo', d: 'Print text to terminal' },
      { n: '>', d: 'Redirect output to a file' },
      { n: '>>', d: 'Append output to a file' },
      { n: '|', d: 'Pipe one command output to another' },
    ],
  },
  {
    name: 'Finding Things',
    cmds: [
      { n: 'find', d: 'Find files in directory hierarchy' },
      { n: 'locate', d: 'Find files by name (quick search)' },
      { n: 'which', d: 'Locate command or binary' },
      { n: 'whereis', d: 'Locate binary, source, man page' },
    ],
  },
  {
    name: 'Compression & Archives',
    cmds: [
      { n: 'tar', d: 'Create / extract tar archives' },
      { n: 'gzip / gunzip', d: 'Compress / decompress files' },
      { n: 'zip / unzip', d: 'Compress / decompress zip files' },
    ],
  },
  {
    name: 'System Info & Resources',
    cmds: [
      { n: 'df', d: 'Disk space usage' },
      { n: 'du', d: 'Disk usage of files/directories' },
      { n: 'free', d: 'Memory usage' },
      { n: 'top', d: 'Real-time process monitoring' },
      { n: 'htop', d: 'Interactive process viewer' },
    ],
  },
  {
    name: 'Processes & Services',
    cmds: [
      { n: 'ps', d: 'Process status (e.g. ps -ef)' },
      { n: 'kill', d: 'Terminate a process (e.g. kill -9 <PID>)' },
      { n: 'systemctl', d: 'Manage systemd services (e.g. systemctl status nginx)' },
      { n: 'service', d: 'Manage services (SysV, e.g. service nginx restart)' },
    ],
  },
  {
    name: 'Networking',
    cmds: [
      { n: 'netstat', d: 'Network connections (e.g. netstat -tulnp)' },
      { n: 'ss', d: 'Socket statistics — modern netstat (e.g. ss -tulnp)' },
      { n: 'ip', d: 'Show/modify network interfaces (e.g. ip a)' },
      { n: 'ping', d: 'Test connectivity' },
      { n: 'curl', d: 'Transfer data from URLs' },
      { n: 'wget', d: 'Download files from the web' },
      { n: 'ssh', d: 'Secure shell to remote host' },
      { n: 'scp', d: 'Secure copy files to remote host' },
    ],
  },
  {
    name: 'Permissions & Users',
    cmds: [
      { n: 'chmod', d: 'Change file permissions' },
      { n: 'chown', d: 'Change file owner/group' },
      { n: 'useradd', d: 'Add a new user' },
      { n: 'usermod', d: 'Modify user account' },
    ],
  },
  {
    name: 'Shell Productivity',
    cmds: [
      { n: 'history', d: 'Show command history' },
      { n: '!!', d: 'Repeat last command' },
      { n: '!<cmd>', d: 'Run last command starting with <cmd>' },
    ],
  },
];
---

<Layout title="50 Linux Commands — Cheatsheet" description="50 most used Linux commands for DevOps and Cloud Engineers — file operations, networking, processes, permissions, compression, and system info.">
  <main>
    <div class="max-w-4xl mx-auto px-6 py-12">
      <a href="/cheatsheet" class="inline-flex items-center gap-1.5 text-sm mb-8" style="color: var(--accent)">
        ← back to cheatsheets
      </a>

      <div class="flex items-center gap-4 mb-2">
        <span class="text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full" style="background: var(--accent); color: #1a1a1a">DevOps</span>
      </div>

      <h1 class="font-black uppercase tracking-tight mb-2" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95">
        50 <span style="color: var(--accent)">Linux Commands</span>
      </h1>
      <p class="text-sm mb-6" style="color: var(--text-muted)">DevOps Essentials — Master the basics, automate the rest!</p>

      <p class="text-sm mb-8 leading-relaxed p-3 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border); color: var(--text-muted)">
        Docker runs on Linux. Kubernetes lives on Linux. Cloud runs on Linux.
      </p>

      <div class="space-y-6 mb-12">
        {CATEGORIES.map(cat => (
          <div>
            <h2 class="text-sm font-black uppercase tracking-wide mb-2" style="color: var(--accent)">{cat.name}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
              {cat.cmds.map(cmd => (
                <div class="flex items-center gap-2 p-2 rounded-lg border text-sm" style="background: var(--bg-card); border-color: var(--border)">
                  <code class="font-bold shrink-0" style="color: var(--accent); font-size: 13px">{cmd.n}</code>
                  <span style="color: var(--text-muted)">{cmd.d}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-sm mb-12">
        {[
          { k: 'Tab', v: 'Auto-complete' },
          { k: 'Ctrl + C', v: 'Cancel' },
          { k: 'Ctrl + Z', v: 'Suspend' },
          { k: 'Ctrl + D', v: 'Logout / exit' },
        ].map(t => (
          <div class="p-2 rounded-xl border-2 text-center" style="background: var(--bg-card); border-color: var(--border)">
            <code class="font-bold text-xs" style="color: var(--accent)">{t.k}</code>
            <p class="text-xs" style="color: var(--text-muted)">{t.v}</p>
          </div>
        ))}
      </div>

      <div class="mt-16 p-4 rounded-xl border-2 text-center" style="background: var(--bg-card); border-color: var(--border)">
        <p class="text-xs font-mono" style="color: var(--text-faint)">
          Learn → Practice → Automate → Grow — Build, Deploy, Scale with Confidence!
        </p>
      </div>

      <div class="mt-8 text-center">
        <a href="/" class="inline-block px-6 py-3 font-bold uppercase tracking-wide text-sm border-2 transition-all" style="background: var(--accent); color: #1a1a1a; border-color: #1a1a1a; box-shadow: 4px 4px 0 #1a1a1a; border-radius: 9999px">
          ← all cheatsheets
        </a>
      </div>
    </div>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.talz.net" },
      { "@type": "ListItem", "position": 2, "name": "Cheatsheets", "item": "https://www.talz.net/cheatsheet/" },
      { "@type": "ListItem", "position": 3, "name": "Linux Commands Cheatsheet", "item": "https://www.talz.net/cheatsheet/linux-commands/" }
    ]
  })} />
</Layout>
