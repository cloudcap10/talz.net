---
import Layout from '@/layouts/Layout.astro';

const CHEATSHEETS = [
  {
    title: 'EIGRP',
    subtitle: 'Enhanced Interior Gateway Routing Protocol',
    href: '/cheatsheet/eigrp',
    desc: 'Cisco proprietary IGP using DUAL algorithm — components, metrics, timers, configuration, and interview questions.',
    tags: ['Cisco', 'DUAL', 'IGP'],
  },
  {
    title: 'OSPF',
    subtitle: 'Open Shortest Path First',
    href: '/cheatsheet/ospf',
    desc: 'Link-State IGP using Dijkstra\'s SPF — areas, LSA types, DR/BDR, cost calculation, and configuration.',
    tags: ['Open Standard', 'SPF', 'IGP'],
  },
  {
    title: 'BGP',
    subtitle: 'Border Gateway Protocol',
    href: '/cheatsheet/bgp',
    desc: 'Path Vector protocol for Internet routing — attributes, best path selection, states, and policies.',
    tags: ['Exterior', 'Path Vector', 'Internet'],
  },
  {
    title: 'Data Center',
    subtitle: 'Facilities & Infrastructure',
    href: '/cheatsheet/datacenter',
    desc: 'Data center fundamentals — components, types, importance, and key concepts for networking engineers.',
    tags: ['Infrastructure', 'Virtualization', 'Cloud'],
  },
  {
    title: 'FortiGate',
    subtitle: 'Fortinet NGFW',
    href: '/cheatsheet/fortigate',
    desc: 'Core capabilities — security, networking, VPN, SD-WAN, segmentation, deployment modes, and traffic flow.',
    tags: ['NGFW', 'VPN', 'SD-WAN'],
  },
  {
    title: 'Cloud Certs',
    subtitle: 'Role-Based Roadmap 2026',
    href: '/cheatsheet/cloud-certifications',
    desc: 'Certification paths for DevOps, MLOps, Architect, AI Engineer, Security, SRE, and Platform Engineering.',
    tags: ['AWS', 'Azure', 'GCP', 'K8s'],
  },
  {
    title: 'Windows Net',
    subtitle: 'CLI Networking Commands',
    href: '/cheatsheet/windows-networking',
    desc: 'Essential Windows networking commands — ipconfig, ping, tracert, netstat, arp, nslookup, and more.',
    tags: ['Windows', 'CLI', 'Troubleshooting'],
  },
  {
    title: 'VMware vs Nutanix',
    subtitle: 'Virtualization vs HCI',
    href: '/cheatsheet/vmware-vs-nutanix',
    desc: 'Compare VMware virtualization and Nutanix hyperconverged infrastructure — strengths, differences, and use cases.',
    tags: ['VMware', 'Nutanix', 'HCI'],
  },
  {
    title: 'Palo Alto NGFW',
    subtitle: 'Next-Generation Firewall',
    href: '/cheatsheet/palo-alto',
    desc: 'Palo Alto NGFW core concepts: App-ID, User-ID, Content-ID, threat prevention, SSL decryption, and NGFW vs traditional firewall.',
    tags: ['NGFW', 'Palo Alto', 'Security'],
  },
];
---

<Layout title="Cheatsheets — Joven Talasan" description="Networking study guides and cheatsheets by Joven Talasan.">
  <main>
    <div class="max-w-4xl mx-auto px-6 py-12">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm mb-8" style="color: var(--accent)">
        ← back to portfolio
      </a>

      <h1 class="font-black uppercase tracking-tight mb-2" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95">
        Cheat<span style="color: var(--accent)">sheets</span>
      </h1>
      <p class="text-sm mb-10 max-w-xl" style="color: var(--text-muted); line-height: 1.7">
        Networking, security, cloud, and infrastructure reference guides — formatted for quick study.
      </p>

      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "Cheatsheets — Joven Talasan",
        "description": "Networking, security, cloud, and infrastructure reference guides — formatted for quick study.",
        "url": "https://talz.net/cheatsheet/",
        "isPartOf": { "@type": "WebSite", "name": "talz.net", "url": "https://talz.net" },
      })} />

      <div class="flex flex-col gap-4">
        {CHEATSHEETS.map(cs => (
          <a href={cs.href} class="p-5 rounded-xl border-2 transition-all" style="background: var(--bg-card); border-color: var(--border)">
            <div class="flex items-start gap-3">
              <div class="flex items-center justify-center w-10 h-10 rounded-lg shrink-0 font-black uppercase" style="background: var(--bg-surface); color: var(--accent); font-size: 14px">
                {cs.title.slice(0, 4)}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="font-bold text-base">{cs.title}</h2>
                  <span class="text-xs" style="color: var(--text-muted)">{cs.subtitle}</span>
                </div>
                <p class="text-sm mt-1 leading-relaxed" style="color: var(--text-muted)">{cs.desc}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {cs.tags.map(tag => (
                    <span class="text-xs px-2 py-0.5 rounded-full font-mono" style="background: var(--bg-surface); color: var(--text-muted)">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
