---
import Layout from '@/layouts/Layout.astro';

const SECTIONS = [
  { id: 'what-is-eigrp', title: 'What is EIGRP?' },
  { id: 'how-eigrp-works', title: 'How EIGRP Works' },
  { id: 'components', title: 'Components' },
  { id: 'neighbor-states', title: 'Neighbor States' },
  { id: 'packet-types', title: 'Packet Types' },
  { id: 'route-types', title: 'Route Types' },
  { id: 'metrics', title: 'Metrics (K Values)' },
  { id: 'timers', title: 'Timers' },
  { id: 'topology-table', title: 'Topology Table' },
  { id: 'dual', title: 'DUAL Algorithm' },
  { id: 'configuration', title: 'Configuration' },
  { id: 'commands', title: 'Commands' },
  { id: 'authentication', title: 'Authentication' },
  { id: 'interview-questions', title: 'Interview Questions' },
  { id: 'advanced', title: 'Advanced Concepts' },
];
---

<Layout title="EIGRP Cheatsheet — Joven Talasan" description="Comprehensive EIGRP study guide covering components, DUAL algorithm, metrics, configuration, and interview questions.">
  <main>
    <div class="max-w-4xl mx-auto px-6 py-12">
      <a href="/cheatsheet" class="inline-flex items-center gap-1.5 text-sm mb-8" style="color: var(--accent)">
        ← back to cheatsheets
      </a>

      <div class="flex items-center gap-4 mb-2">
        <h1 class="font-black uppercase tracking-tight" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 0.95">
          EIGRP<br>
          <span style="color: var(--accent)">Cheatsheet</span>
        </h1>
      </div>
      <p class="text-sm mb-10 max-w-xl" style="color: var(--text-muted); line-height: 1.7">
        Enhanced Interior Gateway Routing Protocol — Cisco proprietary IGP using DUAL algorithm.
        IP protocol number 88.
      </p>

      <div class="flex flex-wrap gap-2 mb-12">
        {SECTIONS.map(s => (
          <a href={"#" + s.id} class="text-xs px-3 py-1 rounded-full font-mono transition-colors" style="background: var(--bg-surface); color: var(--text-muted)">
            {s.title}
          </a>
        ))}
      </div>

      <div class="flex flex-col gap-10">

        <section id="what-is-eigrp">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">1. What is EIGRP?</h2>
          <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
            <p class="text-sm leading-relaxed" style="color: var(--text-muted)">
              EIGRP is a Cisco proprietary Interior Gateway Protocol (IGP) that uses a hybrid of Distance Vector
              and Link-State concepts. It is an advanced distance vector protocol that uses
              <strong style="color: var(--text)">DUAL</strong> (Diffusing Update Algorithm) to ensure loop-free
              routes and fast convergence. It uses <strong style="color: var(--text)">IP protocol number 88</strong>.
            </p>
          </div>
        </section>

        <section id="how-eigrp-works">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">2. How EIGRP Works</h2>
          <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
            <ul class="text-sm leading-relaxed space-y-1.5" style="color: var(--text-muted)">
              <li>• Routers discover neighbors using <strong style="color: var(--text)">Hello</strong> packets.</li>
              <li>• EIGRP maintains a <strong style="color: var(--text)">topology table</strong> with all routes.</li>
              <li>• <strong style="color: var(--text)">DUAL</strong> algorithm computes loop-free routes.</li>
              <li>• Only <strong style="color: var(--text)">incremental updates</strong> are sent (efficient).</li>
              <li>• Best path is installed in the <strong style="color: var(--text)">routing table</strong>.</li>
            </ul>
          </div>
        </section>

        <section id="components">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">3. EIGRP Components</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Component</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)">
                  <td class="px-4 py-2.5 font-mono" style="color: var(--text)">Neighbors</td>
                  <td class="px-4 py-2.5" style="color: var(--text-muted)">Discovered by Hello packets</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border)">
                  <td class="px-4 py-2.5 font-mono" style="color: var(--text)">Topology Table</td>
                  <td class="px-4 py-2.5" style="color: var(--text-muted)">Contains all learned routes</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border)">
                  <td class="px-4 py-2.5 font-mono" style="color: var(--text)">Routing Table</td>
                  <td class="px-4 py-2.5" style="color: var(--text-muted)">Best routes installed</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border)">
                  <td class="px-4 py-2.5 font-mono" style="color: var(--text)">DUAL</td>
                  <td class="px-4 py-2.5" style="color: var(--text-muted)">Diffusing Update Algorithm — loop-free path calculation</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border)">
                  <td class="px-4 py-2.5 font-mono" style="color: var(--text)">Feasible Successor</td>
                  <td class="px-4 py-2.5" style="color: var(--text-muted)">Backup path (loop-free)</td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border)">
                  <td class="px-4 py-2.5 font-mono" style="color: var(--text)">Reported Distance (RD)</td>
                  <td class="px-4 py-2.5" style="color: var(--text-muted)">Distance to a destination as reported by neighbor</td>
                </tr>
                <tr>
                  <td class="px-4 py-2.5 font-mono" style="color: var(--text)">Feasible Distance (FD)</td>
                  <td class="px-4 py-2.5" style="color: var(--text-muted)">RD + Link Cost to the neighbor</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="p-4 rounded-xl border-2 mt-4" style="background: var(--bg-card); border-color: var(--border)">
            <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--accent)">Neighbor Discovery Flow</p>
            <div class="font-mono text-xs leading-loose" style="color: var(--text-muted)">
              No Hello received → Hello sent → Bi-directional Hello received → Adjacency formed
            </div>
          </div>
        </section>

        <section id="neighbor-states">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">4. EIGRP Neighbor States</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">State</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Down</td><td class="px-4 py-2.5" style="color: var(--text-muted)">No Hello received</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Init</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Hello received, adjacency not yet established</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">2-Way</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Bi-directional communication established</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Up</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Full adjacency formed</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="packet-types">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">5. EIGRP Packet Types</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Packet</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Purpose</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Hello</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Discover and maintain neighbors</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Update</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Send routing updates</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Query</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Send when route is lost</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Reply</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Reply to a Query</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">ACK</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Acknowledge packets</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="route-types">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">6. EIGRP Route Types</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Route Type</th>
                  <th class="text-left px-4 py-2.5 font-semibold">AD</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Internal</td><td class="px-4 py-2.5">90</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Within the same AS</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">External</td><td class="px-4 py-2.5">170</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Redistributed from another protocol</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Summary</td><td class="px-4 py-2.5">—</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Manually or automatically summarized</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Floating Static</td><td class="px-4 py-2.5">—</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Backup static route</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="metrics">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">7. EIGRP Metrics (K Values)</h2>
          <div class="p-4 rounded-xl border-2 mb-4" style="background: var(--bg-card); border-color: var(--border)">
            <code class="text-xs leading-relaxed" style="color: var(--text-muted)">
              Metric = [K1*Bandwidth + (K2*Bandwidth)/(256-Load) + K3*Delay] * [K5 / (Reliability + K4)]
            </code>
          </div>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">K Value</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Default</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">K1</td><td class="px-4 py-2.5">1</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Bandwidth (in kbps)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">K2</td><td class="px-4 py-2.5">0</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Load (in 1/255ths)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">K3</td><td class="px-4 py-2.5">1</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Delay (in tens of microseconds)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">K4</td><td class="px-4 py-2.5">0</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Reliability (percentage)</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">K5</td><td class="px-4 py-2.5">0</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Reliability weight</td></tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs mt-3" style="color: var(--text-faint)">Default: Bandwidth + Delay (K1=1, K3=1, others=0). Lower metric = preferred.</p>
        </section>

        <section id="timers">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">8. EIGRP Timers (Default)</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Timer</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Default</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Hello Interval</td><td class="px-4 py-2.5">5 sec (LAN), 15 sec (WAN)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Hold Time</td><td class="px-4 py-2.5">15 sec (LAN), 45 sec (WAN)</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Update Interval (Min)</td><td class="px-4 py-2.5">0.5 sec</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Update Interval (Max)</td><td class="px-4 py-2.5">3 min</td></tr>
                <tr><td class="px-4 py-2.5 font-mono" style="color: var(--text)">Active Timer</td><td class="px-4 py-2.5">3 min</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="topology-table">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">9. EIGRP Topology Table</h2>
          <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
            <ul class="text-sm leading-relaxed space-y-1.5" style="color: var(--text-muted)">
              <li>• Contains all routes learned from all neighbors.</li>
              <li>• Includes feasible successors for backup paths.</li>
              <li>• Not advertised to other routers.</li>
              <li>• Stored in RAM.</li>
            </ul>
          </div>
        </section>

        <section id="dual">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">10. DUAL (Diffusing Update Algorithm)</h2>
          <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
            <ul class="text-sm leading-relaxed space-y-1.5" style="color: var(--text-muted)">
              <li>• Core of EIGRP.</li>
              <li>• Computes loop-free, best path to destination.</li>
              <li>• Provides fast convergence.</li>
              <li>• Uses feasible successors to provide backup paths.</li>
              <li>• Diffuses Queries to find new path when route fails.</li>
              <li>• <strong style="color: var(--text)">Successor</strong> = Best path, <strong style="color: var(--text)">Feasible Successor</strong> = Backup</li>
            </ul>
          </div>
        </section>

        <section id="configuration">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">11. EIGRP Configuration</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
              <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--accent)">Router R1</p>
              <pre class="font-mono text-xs leading-relaxed" style="color: var(--text-muted)">R1(config)# router eigrp 100
R1(config-router)# network 192.168.1.0 0.0.0.255
R1(config-router)# network 192.168.2.0 0.0.0.255
R1(config-router)# no auto-summary</pre>
            </div>
            <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
              <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--accent)">Router R2</p>
              <pre class="font-mono text-xs leading-relaxed" style="color: var(--text-muted)">R2(config)# router eigrp 100
R2(config-router)# network 192.168.2.0 0.0.0.255
R2(config-router)# network 192.168.3.0 0.0.0.255
R2(config-router)# no auto-summary</pre>
            </div>
          </div>
          <p class="text-xs mt-3" style="color: var(--text-faint)">AS Number is locally significant. Use <code>no auto-summary</code> to support VLSM.</p>
        </section>

        <section id="commands">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">12. Important EIGRP Commands</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">Command</th>
                  <th class="text-left px-4 py-2.5 font-semibold">Purpose</th>
                </tr>
              </thead>
              <tbody>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">show ip eigrp neighbors</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Show neighbors</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">show ip eigrp topology</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Show Topology Table</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">show ip route eigrp</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Show EIGRP routes</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">show ip protocols</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Show EIGRP process info</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">show ip eigrp interfaces</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Show interfaces</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">show ip eigrp traffic</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Show traffic statistics</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">debug ip eigrp packets</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Debug EIGRP packets</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">debug ip eigrp events</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Debug EIGRP events</td></tr>
                <tr style="border-bottom: 1px solid var(--border)"><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">clear ip eigrp neighbors</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Clear neighbor adjacency</td></tr>
                <tr><td class="px-4 py-2.5 font-mono text-xs" style="color: var(--text)">clear ip eigrp topology</td><td class="px-4 py-2.5" style="color: var(--text-muted)">Clear EIGRP topology</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section id="authentication">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">13. EIGRP Authentication</h2>
          <div class="p-4 rounded-xl border-2" style="background: var(--bg-card); border-color: var(--border)">
            <p class="text-sm mb-3" style="color: var(--text-muted)">EIGRP supports <strong style="color: var(--text)">MD5 authentication</strong>. Configured under interface mode.</p>
            <pre class="font-mono text-xs leading-relaxed" style="color: var(--text-muted)">interface g0/0
 ip authentication mode eigrp 100 md5
 ip authentication key-chain eigrp EIGRP-KEY
 key chain EIGRP-KEY
  key-string cisco123</pre>
          </div>
        </section>

        <section id="interview-questions">
          <h2 class="font-black uppercase tracking-tight text-xl mb-3">14. EIGRP Interview Questions</h2>
          <div class="rounded-xl border-2 overflow-hidden" style="background: var(--bg-card); border-color: var(--border)">
            <table class="w-full text-sm">
              <thead>
                <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border)">
                  <th class="text-left px-4 py-2.5 font-semibold">#</th>
