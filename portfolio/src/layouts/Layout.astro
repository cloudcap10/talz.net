---
import '@/styles/globals.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const SITE_URL = 'https://www.talz.net';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={SITE_URL + Astro.url.pathname} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE_URL + Astro.url.pathname} />
    <meta property="og:image" content={SITE_URL + '/og-image.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Onest:wght@400;500;600;700;800;900&display=swap');
    </style>
  </head>
  <body>
    <slot />
    <script>
      (() => {
        const CHEATSHEETS = [
          { topic: 'EIGRP', path: '/cheatsheet/eigrp/', desc: 'Cisco EIGRP — DUAL algorithm, metrics, configuration' },
          { topic: 'OSPF', path: '/cheatsheet/ospf/', desc: 'OSPF — areas, LSA types, DR/BDR, cost calculation' },
          { topic: 'BGP', path: '/cheatsheet/bgp/', desc: 'BGP — path attributes, best path selection, states' },
          { topic: 'Data Center', path: '/cheatsheet/datacenter/', desc: 'Data center fundamentals — components, tiers, cooling' },
          { topic: 'FortiGate', path: '/cheatsheet/fortigate/', desc: 'FortiGate NGFW — security, VPN, SD-WAN, traffic flow' },
          { topic: 'Cloud Certifications', path: '/cheatsheet/cloud-certifications/', desc: 'Cloud certification roadmap 2026 — DevOps, AI, Security' },
          { topic: 'Windows Networking', path: '/cheatsheet/windows-networking/', desc: 'Windows CLI — ipconfig, ping, tracert, netstat, arp' },
          { topic: 'VMware vs Nutanix', path: '/cheatsheet/vmware-vs-nutanix/', desc: 'VMware vs Nutanix — virtualization vs HCI comparison' },
          { topic: 'Palo Alto NGFW', path: '/cheatsheet/palo-alto/', desc: 'Palo Alto NGFW — App-ID, User-ID, threat prevention' },
          { topic: 'ACI Fabric Discovery', path: '/cheatsheet/aci-fabric-discovery/', desc: 'Cisco ACI — APIC setup, LLDP, DHCP TEP, IS-IS, cluster formation' },
          { topic: 'VPN Types', path: '/cheatsheet/vpn-types/', desc: '6 VPN types — Remote Access, Site-to-Site, Cloud, Mobile, SSL/TLS, Split Tunnel' },
          { topic: 'Linux Commands', path: '/cheatsheet/linux-commands/', desc: '50 Linux commands — navigation, networking, processes, permissions' },
        ];

        const mc = navigator.modelContext;
        if (mc && typeof mc.registerTool === 'function') {
          const abort = new AbortController();
          mc.registerTool({
            name: 'searchCheatsheets',
            description: 'Search networking and infrastructure cheatsheets by topic keyword on talz.net',
            inputSchema: {
              type: 'object',
              properties: {
                query: { type: 'string', description: 'Topic to search for (e.g. routing, firewall, cloud, eigrp)' },
              },
              required: ['query'],
            },
            execute: async (args) => {
              const q = (args.query || '').toLowerCase();
              return CHEATSHEETS.filter(c =>
                c.topic.toLowerCase().includes(q) || c.desc.toLowerCase().includes(q)
              ).map(c => ({ title: c.topic, url: 'https://www.talz.net' + c.path, summary: c.desc }));
            },
          }, { signal: abort.signal });
        }
      })();
    </script>
  </body>
</html>
<style is:global>
  @view-transition { navigation: auto; }
</style>
